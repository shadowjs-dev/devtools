{
  "name": "@shadow-js/devtools",
  "version": "1.0.3",
  "description": "A development panel that shows the components, signals, effects and updates of a running app",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "!dist/extension",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native && node extension/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p extension/tsconfig.json && npm run typecheck:types",
    "typecheck:types": "tsc -p tsconfig.test-types.json",
    "build:extension": "node extension/build.mjs",
    "zip:extension": "node extension/zip.mjs",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "peerDependencies": {
    "@shadow-js/core": "^1.0.3",
    "@shadow-js/web": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shadow-js/compiler": "^1.0.3",
    "@shadow-js/core": "^1.0.3",
    "@shadow-js/web": "^1.0.3",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.3",
    "rolldown": "1.2.13",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "keywords": [
    "shadowjs",
    "devtools",
    "signals",
    "reactivity"
  ],
  "homepage": "https://devtools.shadowjs.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/devtools.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/devtools/issues"
  }
}
